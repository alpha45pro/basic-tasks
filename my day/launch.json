{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Cal",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/cal.out",   // 👈 must match your compiled file
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build"
        }
    ]
}
